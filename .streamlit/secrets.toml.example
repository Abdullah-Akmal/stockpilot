# Copy to .streamlit/secrets.toml for local runs, or paste into Streamlit Cloud > App settings > Secrets.

[live]
# Google Sheets > File > Share > Publish to web > (your sheet) > Comma-separated values (.csv) > Publish
csv_url = "https://docs.google.com/spreadsheets/d/e/XXXXXXXX/pub?gid=0&single=true&output=csv"

# Optional: read a private sheet with a service account instead of a published CSV.
# sheet_key = "the-long-id-in-the-sheet-url"
# worksheet = "Sheet1"
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "stockpilot@your-project.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
